[Unit]
Description=OLC Worker01 pilot agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/SplitChain
ExecStart=%h/SplitChain/.venv/bin/python -m splitchain.olc_worker --genesis %h/SplitChain/configs/testnet-genesis.json --token-file %h/.config/olc/worker-token
Restart=on-failure
RestartSec=15
Delegate=yes

[Install]
WantedBy=default.target
