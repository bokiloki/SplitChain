# Copy to .env.single-host and generate a random secret before starting.
SPLITCHAIN_CLUSTER_SECRET=
# Required only when using compose.testnet.public.yaml:
PUBLIC_TESTNET_DOMAIN=splitchain.bokiloki.ddns.net
# Required when using the public overlay, even with an existing Nginx proxy.
AUTH_FILE=/srv/splitchain-testnet/accounts.json
# Create this 0700 directory and copy accounts.json (0600, readable by UID 65532) into it before starting.
AUTH_DIRECTORY=/srv/splitchain-testnet/auth
# Private operator dashboard password (at least 32 random characters).
TESTNET_ENROLLMENT_PASSWORD=
